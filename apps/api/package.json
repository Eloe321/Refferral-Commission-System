{
  "name": "@referral-sandbox/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @referral-sandbox/contracts build && pnpm --filter @referral-sandbox/database build && exec tsx watch src/main.ts",
    "build": "pnpm --filter @referral-sandbox/contracts build && pnpm --filter @referral-sandbox/database build && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@referral-sandbox/contracts": "workspace:*",
    "@referral-sandbox/database": "workspace:*",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@nestjs/testing": "12.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
