{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "paths": {
      "@referral-sandbox/contracts": ["./packages/contracts/src/index.ts"],
      "@referral-sandbox/contracts/*": ["./packages/contracts/src/*"],
      "@referral-sandbox/database": ["./packages/database/src/index.ts"],
      "@referral-sandbox/database/*": ["./packages/database/src/*"],
      "@referral-sandbox/ui": ["./packages/ui/src/index.ts"],
      "@referral-sandbox/ui/*": ["./packages/ui/src/*"]
    }
  }
}
