{
  "name": "referral-commission-sandbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @referral-sandbox/contracts --filter @referral-sandbox/database --filter @referral-sandbox/api --filter @referral-sandbox/web dev",
    "lint": "eslint eslint.config.mjs vitest.workspace.ts playwright.config.ts apps/api/vitest.e2e.config.ts scripts/*.mjs tests/e2e/**/*.ts && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:api-e2e",
    "test:prepare": "pnpm --filter @referral-sandbox/contracts build && pnpm --filter @referral-sandbox/database build",
    "test:unit": "pnpm test:prepare && vitest run --config vitest.workspace.ts --project unit",
    "test:integration": "pnpm test:prepare && vitest run --config vitest.workspace.ts --project integration",
    "test:api-e2e": "pnpm test:prepare && pnpm --filter @referral-sandbox/api test:e2e",
    "test:e2e": "node --test scripts/run-playwright.test.mjs && docker compose down && node scripts/run-playwright.mjs",
    "db:generate": "pnpm --filter @referral-sandbox/database db:generate",
    "db:migrate": "pnpm --filter @referral-sandbox/database db:migrate",
    "db:seed": "pnpm --filter @referral-sandbox/database db:seed",
    "privacy:check": "node --test scripts/privacy-check.test.mjs && node scripts/privacy-check.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm privacy:check && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
